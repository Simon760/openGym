{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "state": {
          ".validate": "newData.hasChildren(['_ts'])",
          "_ts": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
