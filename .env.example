# openGym configuration — copy to .env and edit:  cp .env.example .env
#
# Defaults work as-is for a local instance on http://localhost:8080.
# For anything reachable from another device you MUST set RP_ID and ORIGIN,
# because passkeys are cryptographically bound to the hostname they were
# created on. See docs/SELF_HOSTING.md.

# --- Required for a real deployment -----------------------------------------

# Hostname passkeys are bound to. Hostname only — no scheme, no port, no path.
# Changing this later invalidates every passkey already registered.
RP_ID=localhost

# Full URL the app is served from, exactly as it appears in the address bar
# (scheme + host + port). Must match RP_ID's host, or login fails verification.
ORIGIN=http://localhost:8080

# --- Optional ---------------------------------------------------------------

# Host port for the web UI. Change if 8080 is taken (update ORIGIN to match).
WEB_PORT=8080

# Name shown in the passkey prompt on your phone.
RP_NAME=openGym

# Comma-separated user ids that get the admin dashboard. Empty = no admin, and
# the instance stays open to anyone who can reach it. Find your id in
# Settings → Profile.
ADMIN_UIDS=

# Set to 1 to require an invite code to create a profile. Codes are generated
# from the admin dashboard, so this needs ADMIN_UIDS set to be usable.
INVITE_ONLY=

# How long a signed-in session lasts, in days. Baked into each cookie when it
# is issued, so lowering it never cuts existing sessions short.
SESSION_DAYS=90

# Contact URI push services can reach you at (mailto: or https:). Defaults to
# ORIGIN over HTTPS. Only relevant if push delivery gets rejected.
VAPID_SUBJECT=
